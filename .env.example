# === Sao chép file này thành ".env" và điền giá trị thật của bạn. ===
# TUYỆT ĐỐI KHÔNG commit file ".env" vào git (đã có trong .gitignore).
# File ".env" chỉ nên tồn tại trên máy chạy tác vụ này, không chia sẻ, không gửi qua email/chat.

# --- Thông tin đăng nhập tra cứu MVDIS (bắt buộc) ---
# 身分證字號 (số CMND/CCCD Đài Loan)
MVDIS_UID=
# 出生年月日 theo định dạng dân quốc (ROC), 7 chữ số. Ví dụ: dân quốc 78 năm 7 tháng 2 ngày -> 0780702
MVDIS_BIRTHDAY=

# --- Chế độ giải captcha ---
# "auto"     : tự giải captcha bằng thư viện ddddocr (OCR cục bộ), chạy nền không cần người gõ tay.
#              Nếu mã sai, script sẽ tự tải captcha mới và thử lại (tối đa MAX_CAPTCHA_RETRIES lần).
#              Cần cài: pip install ddddocr  (bạn tự chịu trách nhiệm về ToS của MVDIS khi dùng).
# "manual"   : script dừng lại, in đường dẫn ảnh captcha đã chụp và chờ bạn gõ mã qua bàn phím (input()).
#              Chỉ dùng được khi có người ngồi trước máy / terminal tương tác.
# "external" : script gọi một lệnh ngoài (do BẠN tự viết/cấu hình) để lấy mã captcha, dùng cho chạy nền
#              không người theo dõi. Script KHÔNG tự động giải captcha — bạn phải tự cung cấp cơ chế này
#              (ví dụ dịch vụ OCR/captcha-solving riêng của bạn, tự chịu trách nhiệm về ToS của MVDIS).
CAPTCHA_MODE=manual

# Chỉ cần khi CAPTCHA_MODE=external: một lệnh shell, script sẽ gọi:
#   <CAPTCHA_SOLVER_CMD> <đường_dẫn_ảnh_captcha.png>
# và đọc mã captcha từ dòng đầu tiên của stdout.
CAPTCHA_SOLVER_CMD=

# Số lần thử lại tối đa nếu captcha sai (mặc định 3)
MAX_CAPTCHA_RETRIES=3

# MVDIS chặn trình duyệt headless (trả về "302 Security Redirect"), vì vậy để HEADLESS=false.
HEADLESS=false
# Trình duyệt Playwright dùng: "chrome" (Google Chrome đã cài), "msedge", hoặc để trống = Chromium kèm Playwright
# (Chromium kèm Playwright hiện bị lỗi SSL với trang MVDIS).
BROWSER_CHANNEL=chrome

# Bật (true) = nếu tra cứu thành công mà KHÔNG có vi phạm thì không gửi email.
# Tắt (false, mặc định) = luôn gửi báo cáo hàng tuần. Lỗi tra cứu / cần kiểm tra thủ công vẫn luôn gửi mail.
SKIP_EMAIL_IF_NO_VIOLATION=false

# Nếu kết quả là "Cần kiểm tra thủ công" (không nhận diện được trang kết quả) thì tra cứu lại trong
# phiên trình duyệt mới để xác nhận trước khi gửi mail. Số lần tra cứu lại tối đa (0 = tắt, tối đa 3).
UNKNOWN_RECHECK_ATTEMPTS=1

# --- Gửi email báo cáo hàng tuần qua Gmail SMTP ---
# Dùng "Mật khẩu ứng dụng" (App Password) của Gmail, KHÔNG dùng mật khẩu đăng nhập thường.
# Tạo tại: https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Danh sách người nhận, cách nhau bởi dấu phẩy
MAIL_TO=lechihieu.nctu@gmail.com,chihieu_le@phison.com

# Thư mục lưu ảnh chụp (captcha / kết quả), log và history.json
OUTPUT_DIR=./output

# --- CrewAI / OpenAI ---
# Nếu để trống OPENAI_API_KEY, chương trình vẫn chạy nhưng bỏ qua LLM (email dựng sẵn).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
